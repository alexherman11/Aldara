{
  "name": "habla-prototype",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc && npm run build --prefix web",
    "agent": "tsx src/agent.ts dev",
    "server": "tsx src/token-server.ts",
    "web": "npm run dev --prefix web",
    "livekit": "node scripts/start-livekit.mjs",
    "dev": "concurrently -n livekit,server,agent,web -c yellow,blue,magenta,green \"npm:livekit\" \"npm:server\" \"npm:agent\" \"npm:web\"",
    "setup-db": "tsx scripts/setup-db.ts",
    "test": "tsx scripts/run-unit-tests.ts",
    "test-compaction": "tsx scripts/test-compaction.ts",
    "screenshot": "node scripts/screenshot.mjs",
    "dev-stack": "node scripts/dev-stack.mjs",
    "test-bad-pron": "tsx scripts/test-bad-pronunciation.ts",
    "test-visual-bad-pron": "node scripts/test-visual-bad-pronunciation.mjs",
    "test-visual-convo": "node scripts/test-visual-conversation.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.89.0",
    "@livekit/agents": "1.2.6",
    "@livekit/agents-plugin-assemblyai": "^1.2.8",
    "@livekit/agents-plugin-cartesia": "latest",
    "@livekit/agents-plugin-deepgram": "latest",
    "@livekit/agents-plugin-google": "1.2.6",
    "@livekit/agents-plugin-inworld": "^1.2.6",
    "@livekit/agents-plugin-openai": "latest",
    "@livekit/agents-plugin-silero": "latest",
    "@livekit/rtc-node": "^0.13.28",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "livekit-server-sdk": "^2.9.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.49.0",
    "pg": "^8.13.0",
    "ts-fsrs": "^4.5.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.0",
    "playwright": "^1.60.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
