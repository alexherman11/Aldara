# ═══════════════════════════════════════════
# Habla — example .env. Copy to `.env`.
# ═══════════════════════════════════════════

# ── Speech-to-Text (Deepgram nova-3) ──
DEEPGRAM_API_KEY=

# ── Conversational LLM (OpenAI gpt-4o) ──
OPENAI_API_KEY=

# ── Compaction LLM (Anthropic Sonnet) ──
ANTHROPIC_API_KEY=

# ── Text-to-Speech ──
# TTS_PROVIDER is the server-side default; the web app's Settings drawer voice
# selector overrides it per session. Valid values:
#   cartesia | openai | google | chirp | google-flash | google-pro | inworld
# (google-flash / google-pro are legacy aliases for the Gemini 2.5 Flash / Pro
#  surfaces; the new `google` value also uses Gemini 2.5 Flash and is what the
#  new paired provider+voice picker emits.)
# TTS_PROVIDER=cartesia
# OPENAI_TTS_VOICE=shimmer        (OpenAI reuses OPENAI_API_KEY — no extra key)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=5c5ad5e7-1020-476b-8b91-fdcbe9cc313c
# Google Gemini 2.5 TTS — AI Studio API key + optional voice name.
# Get a key at https://aistudio.google.com/apikey (free tier works for voice).
# The SAME key drives the `chirp` provider (Google Cloud TTS / Chirp 3 HD)
# as long as the Cloud Text-to-Speech API is enabled on the project at
# https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
GOOGLE_API_KEY=
GEMINI_TTS_VOICE=Aoede
# Optional: Vertex AI service-account credentials. Not needed for the `chirp`
# provider — it uses GOOGLE_API_KEY against the REST endpoint. Only set this
# if/when the agent switches to VertexAI for some other surface. Generate at
# https://console.cloud.google.com/iam-admin/serviceaccounts and download the
# JSON key file.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Inworld TTS-2 — base64 "key:secret" credential + optional model/voice.
INWORLD_API_KEY=
INWORLD_TTS_MODEL=inworld-tts-2
INWORLD_VOICE=Ashley

# ── Pronunciation assessment (optional) ──
# If neither is set the agent falls back to a local segmented scorer.
SPEECHACE_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ── LiveKit (real-time audio transport) ──
# Default: self-hosted livekit-server (see tools/livekit/ + `npm run livekit`).
# The API key/secret below must match the `keys:` block in tools/livekit/livekit.yaml.
# Swap LIVEKIT_URL for wss://your-project.livekit.cloud if you switch to Cloud.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://127.0.0.1:7880

# ── Postgres ──
# A fresh local database; setup-db will create tables if missing.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/habla

# ── Optional debug flags ──
# Set LEARNER_ID to override the per-session learner that the agent loads.
# Leave unset in normal use — the web app passes the real learner via dispatch metadata.
# LEARNER_ID=00000000-0000-0000-0000-000000000aaa
# Set RECORD_TURNS=1 to capture each PTT turn as WAV+JSON under recordings/.
# RECORD_TURNS=0
